# Copy these values into Coolify environment variables for the staging Docker
# Compose application. Do not commit real secret values.

# --- Bundled Postgres (embedded-db profile) ---
POSTGRES_DB=horilla_staging
POSTGRES_USER=horilla
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Containerized Postgres is for disposable staging data only. Move the database
# to managed/dedicated infrastructure before storing real employee or payroll
# history. POSTGRES_* values configure only that optional container; they are
# not the app's database connection contract.

# COMPOSE_PROFILES is a Compose CLI variable read directly from this env file;
# it is not passed through to any container. Remove embedded-db when using a
# dedicated/managed database.
COMPOSE_PROFILES=embedded-db

# --- App database connection ---
# For the embedded Postgres profile, keep the host as "postgres". For a
# dedicated/managed database, replace host, user and password here, set DB_HOST
# and DB_PORT to match (the entrypoint waits on them before migrating), and
# remove embedded-db from COMPOSE_PROFILES above.
DATABASE_URL=postgres://horilla:replace-with-a-strong-database-password@postgres:5432/horilla_staging
DB_HOST=postgres
DB_PORT=5432

# --- Redis cache ---
# Avoid "$" in passwords here: Compose treats it as variable interpolation.
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0

# --- Django ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-value
# Password that guards the first-run /initialize-database page. Must not be a
# documented default; production security checks refuse to start otherwise.
DB_INIT_PASSWORD=replace-with-a-strong-init-password
# Keep localhost: the container healthcheck calls http://localhost:8000/health/
# and Django rejects hosts not listed here.
ALLOWED_HOSTS=hr.staging.your-domain.com,localhost
# Must include the scheme.
CSRF_TRUSTED_ORIGINS=https://hr.staging.your-domain.com
TIME_ZONE=Asia/Kolkata
# Tags Sentry events and logs. DEBUG is forced to 0 in the compose file.
HORILLA_ENV=staging

# Coolify's proxy terminates TLS and already redirects HTTP to HTTPS, so leave
# Django's redirect off. Set to 1 only if the proxy does not redirect.
SECURE_SSL_REDIRECT=0
# Number of reverse-proxy hops in front of gunicorn (Coolify's Traefik = 1).
# django-axes uses this to find the real client IP for login lockouts.
AXES_PROXY_COUNT=1

# --- Optional ---
# SENTRY_DSN=
# DJANGO_LOG_LEVEL=INFO
# GUNICORN_WORKERS=4
# GUNICORN_LOG_LEVEL=info
